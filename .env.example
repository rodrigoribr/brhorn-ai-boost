# Copie para .env (gitignored). Nada aqui é segredo de servidor: tudo com VITE_ vai no bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# DEV-0004: API do chat de diagnóstico (brhorn-chat). Produção: https://chat.brhorn.com.
# No dev, sobrescreva em .env.development.local com http://localhost:3005.
VITE_CHAT_API_URL=https://chat.brhorn.com

# DEV-0005: 1 = o botão "Fazer diagnóstico" abre o chat (DEV-0004). Vazio = leva ao WhatsApp da empresa.
VITE_DIAGNOSTICO_ATIVO=
